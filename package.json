{
  "name": "api-clinico-db",
  "version": "1.0.0",
  "description": "API-REST: para la gestión clínica para la Unidad Educativa Don Bosco Sucre",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "copy-fonts": "mkdir -p dist/fonts && cp -r src/fonts/* dist/fonts/",
    "format": "prettier --write .",
    "lint": "tsc --noEmit && eslint \"src/**/*.ts*\"",
    "start": "node dist/server.js",
    "dev:old": "dotenv -- nodemon --exec \"node -r esbuild-register src/server.ts\" -e .ts",
    "dev": "SET DEBUG=app:server & nodemon --exec \"node -r esbuild-register src/server.ts\" -e .ts",
    "start:local": "NODE_ENV=development DEBUG=clinico-api*,app:*,error:* nodemon src/server.ts",
    "start:localw": "SET NODE_ENV=development & SET DEBUG=clinico-api*,app:*,error:* & nodemon src/server.ts",
    "init-condicion-base": "ts-node scripts/initCondicionBase.ts",
    "add:user": "ts-node scripts/addUser.ts"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:Zarael25/api-clinico-db.git"
  },
  "keywords": [
    "API",
    "NODE",
    "TS",
    "CLINICA",
    "DON-BOSCO-SUCRE"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Zarael25/api-clinico-db/issues"
  },
  "homepage": "https://donboscosucre.edu.bo",
  "packageManager": "pnpm@9.9.0+sha512.60c18acd138bff695d339be6ad13f7e936eea6745660d4cc4a776d5247c540d0edee1a563695c183a66eb917ef88f2b4feb1fc25f32a7adcadc7aaf3438e99c1",
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/boom": "^7.3.5",
    "@types/inquirer": "^9.0.9",
    "@types/minimist": "^1.2.5",
    "@vercel/node": "^5.3.24",
    "chalk": "^4.1.2",
    "esbuild-register": "^3.6.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "globals": "^16.3.0",
    "inquirer": "^12.9.3",
    "minimist": "^1.2.8",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@types/node": "^24.7.0",
    "@types/express": "^5.0.3",
    "@types/cors": "^2.8.19",
    "@types/morgan": "^1.9.10",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/debug": "^4.1.12",

    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "debug": "^4.4.1",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "liqe": "^3.8.3",
    "mongoose": "^8.17.1",
    "morgan": "^1.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfmake": "^0.2.20"
  }
}
